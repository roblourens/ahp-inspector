{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AHP Viewer Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        "${workspaceFolder}/test/fixtures/long-realistic-ahp.jsonl",
        "--agents"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.cjs"],
      "preLaunchTask": "extension: build"
    }
  ]
}
