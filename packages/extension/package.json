{
  "name": "@ahp-inspector/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "displayName": "AHP Inspector",
  "description": "Local-first viewer for Agent Host Protocol JSONL traffic logs.",
  "publisher": "ahp-inspector",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ahpInspector.open",
        "title": "Open",
        "category": "AHP Inspector"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && node ./scripts/copy-ui-dist.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@ahp-inspector/core": "workspace:*",
    "@ahp-inspector/host-node": "workspace:*",
    "@ahp-inspector/parser": "workspace:*",
    "@ahp-inspector/server": "workspace:*",
    "@ahp-inspector/shared": "workspace:*"
  },
  "devDependencies": {
    "@ahp-inspector/ui": "workspace:*",
    "@types/vscode": "^1.95.0"
  }
}
