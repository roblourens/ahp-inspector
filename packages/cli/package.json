{
  "name": "@ahp-viewer/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "ahp-viewer": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --shims"
  },
  "dependencies": {
    "@ahp-viewer/core": "workspace:*",
    "@ahp-viewer/host-node": "workspace:*",
    "@ahp-viewer/parser": "workspace:*",
    "@ahp-viewer/server": "workspace:*",
    "@ahp-viewer/shared": "workspace:*",
    "commander": "^14.0.3"
  }
}
