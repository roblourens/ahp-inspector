{
  "name": "ahp-inspector",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first GUI for exploring Agent Host Protocol JSONL traffic logs.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roblourens/ahp-inspector.git"
  },
  "keywords": [
    "agent-host-protocol",
    "jsonl",
    "json-rpc",
    "log-viewer",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:ahp": "tsx scripts/sync-agent-host-protocol.ts",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "start:fixture": "pnpm -F @ahp-inspector/ui build && pnpm exec tsx packages/cli/src/index.ts test/fixtures/phase3-mini.jsonl",
    "start:long": "pnpm -F @ahp-inspector/ui build && pnpm exec tsx packages/cli/src/index.ts test/fixtures/long-realistic-ahp.jsonl",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
